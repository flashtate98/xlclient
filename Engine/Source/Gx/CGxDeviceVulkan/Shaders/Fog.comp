// SXC: the volumetric fog's froxel volume (when not marching per pixel): one thread per column walks
// its slices from the camera out, integrating the medium (Fog.glsl) in steps, and writes what has built
// up so far: the light scattered toward the camera and the transmittance. Fog.frag reads its pixel's
// texel.
#version 450
#extension GL_GOOGLE_include_directive : require

#include "Fog.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 3, rgba16f) uniform writeonly image3D volume;

const int kMaxSubSteps = 32; // a slice is cut into steps of fp.colour.a yd, at most this many

void main()
{
    ivec3 size = imageSize(volume);
    ivec2 column = ivec2(gl_GlobalInvocationID.xy);

    if (column.x >= size.x || column.y >= size.y)
    {
        return;
    }

    // Nothing to fill when every pixel marches its own ray.
    if (fp.march.x > 0.5)
    {
        return;
    }

    // The column's ray: its texel centre across the viewport, as clip x, y (D3D: y up).
    vec2 uv = (vec2(column) + 0.5) / vec2(size.xy);
    vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
    vec3 dir = normalize(Unproject(ndc, 1.0) - Unproject(ndc, 0.0));

    vec3 scattered = vec3(0.0);
    float transmittance = 1.0;
    float from = 0.0;
    vec3 a = fp.origin.xyz;
    Field fa = SampleField(a.xy);

    for (int k = 0; k < kSlices; k++)
    {
        float to = SliceEdge(float(k + 1));
        int steps = clamp(int(ceil((to - from) / max(fp.colour.a, 0.1))), 1, kMaxSubSteps);
        float len = (to - from) / float(steps);

        for (int s = 1; s <= steps; s++)
        {
            vec3 b = fp.origin.xyz + dir * (from + len * float(s));
            Field fb = SampleField(b.xy);
            vec4 medium = StepMedium(a, b, fa, fb, false);
            float sigma = medium.a;
            float step = exp(-sigma * len);
            vec3 colour = sigma > 0.0 ? medium.rgb / sigma + FogLightIn(uv, from + len * (float(s) - 0.5)) : fp.colour.rgb;
            scattered += transmittance * (1.0 - step) * colour;
            transmittance *= step;
            a = b;
            fa = fb;
        }

        imageStore(volume, ivec3(column, k), vec4(scattered, transmittance));
        from = to;
    }
}
